{
  "name": "repohive",
  "version": "0.0.0",
  "private": true,
  "description": "RepoHIVE — Repository Hierarchical Indexing & Visualization Engine. Transforms a flat dependency graph into a navigable multi-level hierarchy. (Command names are placeholders.)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/parser packages/core",
    "typecheck": "tsc -b packages/parser packages/core",
    "parse": "npm run parse --workspace @repohive/parser --",
    "group": "npm run group --workspace @repohive/core --",
    "demo:group-determinism": "npm run demo:group-determinism --workspace @repohive/core --",
    "demo:baselines": "npm run demo:baselines --workspace @repohive/core --",
    "test": "npm run test --workspaces --if-present"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "20.19.9",
    "shadcn": "^4.12.0",
    "typescript": "5.9.3"
  }
}
