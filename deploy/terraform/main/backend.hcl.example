# Copy to backend.hcl and fill in from the bootstrap root's output:
#   terraform -chdir=deploy/terraform/bootstrap output state_bucket
# Then: terraform -chdir=deploy/terraform/main init -backend-config=backend.hcl
bucket = "repohive-tfstate-123456789012"
key    = "main/terraform.tfstate"
region = "ap-south-1"
