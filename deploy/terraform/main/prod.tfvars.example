# Optional tuning of the main root. Copy what you change to deploy/accounts/<name>/main.tfvars (git-ignored); apply.sh
# passes that file when it exists. The required values (account id, owner tag, site domain, alert email, protect) come
# from the account's deploy.env, and indexer_image_digest from ECR (deploy.sh infra): do not set them here.
# Defaults shown.

# log_retention_days          = 14
# lambda_memory_mb            = 3008
# lambda_timeout_seconds      = 300
# lambda_ephemeral_storage_mb = 512
# fargate_cpu_units           = 8192
# fargate_memory_mb           = 16384

# Alarms and budget (counts are totals per 5 minutes, heartbeat_bad_minutes is consecutive minutes):
# alarm_thresholds = {
#   executions_failed     = 1
#   executions_timed_out  = 1
#   indexer_errors        = 3
#   indexer_throttles     = 1
#   jobs_failed_system    = 3
#   heartbeat_bad_minutes = 5
# }
# monthly_budget_usd = 25

# The box (all unmeasured defaults):
# box_root_volume_gb                   = 12
# box_data_volume_gb                   = 8
# server_memory_max_mb                 = 1280
# server_heap_mb                       = 512
# caddy_rate_limit_per_minute          = 300
# caddy_rate_limit_api_post_per_minute = 30

# The origin of the owner-hosted limits page (it calls /api/admin/** from a browser). Empty allows none, and the
# admin API stays off until deploy/scripts/put-admin-token.sh has stored a token:
# admin_origins = ["https://hivequota.themaverick.tech"]
