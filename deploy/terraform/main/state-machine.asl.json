{
  "Comment": "repohive-index: routes one indexing run by tier and runs it, nothing else. The server owns the job: its ledger, the large-job slot, retier, restart-once and the failure codes (it reads this execution's status in its reconciliation). The worker reports progress and the outcome to the server itself.",
  "QueryLanguage": "JSONata",
  "TimeoutSeconds": 3600,
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "job is the input, unchanged: jobId, accountId, repo, commitSha, tier, snapshotId, visibility. failure holds the error of a run that went wrong.",
      "Assign": {
        "job": "{% $states.input %}",
        "failure": {}
      },
      "Next": "RouteTier"
    },

    "RouteTier": {
      "Type": "Choice",
      "Comment": "S and M run on Lambda, L and XL on Fargate. The job re-runs the pre-check itself, so this does not.",
      "Choices": [
        {
          "Condition": "{% $job.tier = 'S' or $job.tier = 'M' %}",
          "Next": "RunLambda"
        },
        {
          "Condition": "{% $job.tier = 'L' %}",
          "Next": "RunFargateL"
        },
        {
          "Condition": "{% $job.tier = 'XL' %}",
          "Next": "RunFargateXL"
        }
      ],
      "Default": "FailUnknownTier"
    },

    "RunLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${indexer_function_arn}",
        "Payload": "{% $job %}"
      },
      "TimeoutSeconds": 330,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}" },
          "Next": "FailRun"
        }
      ],
      "Next": "Succeed"
    },

    "RunFargateL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${task_definition_family}",
        "LaunchType": "FARGATE",
        "Group": "{% 'job-' & $job.jobId %}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${subnet_a}", "${subnet_b}"],
            "SecurityGroups": ["${security_group}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${container_name}",
              "Environment": [
                { "Name": "REPOHIVE_JOB_INPUT", "Value": "{% $string($job) %}" },
                { "Name": "REPOHIVE_TIME_LIMIT_MS", "Value": "600000" }
              ]
            }
          ]
        }
      },
      "TimeoutSeconds": 780,
      "Retry": [
        {
          "ErrorEquals": ["ECS.AmazonECSException"],
          "IntervalSeconds": 30,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}" },
          "Next": "ListRunningTasks"
        }
      ],
      "Next": "Succeed"
    },

    "RunFargateXL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${task_definition_family}",
        "LaunchType": "FARGATE",
        "Group": "{% 'job-' & $job.jobId %}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${subnet_a}", "${subnet_b}"],
            "SecurityGroups": ["${security_group}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${container_name}",
              "Environment": [
                { "Name": "REPOHIVE_JOB_INPUT", "Value": "{% $string($job) %}" },
                { "Name": "REPOHIVE_TIME_LIMIT_MS", "Value": "900000" }
              ]
            }
          ]
        }
      },
      "TimeoutSeconds": 1080,
      "Retry": [
        {
          "ErrorEquals": ["ECS.AmazonECSException"],
          "IntervalSeconds": 30,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "failure": "{% $states.errorOutput %}" },
          "Next": "ListRunningTasks"
        }
      ],
      "Next": "Succeed"
    },

    "ListRunningTasks": {
      "Type": "Task",
      "Comment": "After a timeout or error, list the indexer tasks still running; DescribeRunningTasks keeps this job's.",
      "Resource": "arn:aws:states:::aws-sdk:ecs:listTasks",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "Family": "${task_definition_family}",
        "DesiredStatus": "RUNNING"
      },
      "Assign": {
        "taskArns": "{% $append([], $states.result.TaskArns) %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailRun"
        }
      ],
      "Next": "AnyRunningTasks"
    },

    "AnyRunningTasks": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($taskArns) > 0 %}",
          "Next": "DescribeRunningTasks"
        }
      ],
      "Default": "FailRun"
    },

    "DescribeRunningTasks": {
      "Type": "Task",
      "Comment": "The run task states put each task in the group job-<jobId> (ecs:runTask.sync does not accept StartedBy).",
      "Resource": "arn:aws:states:::aws-sdk:ecs:describeTasks",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "Tasks": "{% $taskArns %}"
      },
      "Assign": {
        "taskArns": "{% $append([], $states.result.Tasks[Group = 'job-' & $job.jobId].TaskArn) %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailRun"
        }
      ],
      "Next": "StopRunningTasks"
    },

    "StopRunningTasks": {
      "Type": "Map",
      "Items": "{% $taskArns %}",
      "MaxConcurrency": 1,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "StopTask",
        "States": {
          "StopTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ecs:stopTask",
            "Arguments": {
              "Cluster": "${cluster_arn}",
              "Task": "{% $states.input %}",
              "Reason": "repohive-index stopped a task left running after a timeout or error"
            },
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "StopTaskIgnored"
              }
            ],
            "End": true
          },
          "StopTaskIgnored": {
            "Type": "Pass",
            "Comment": "A task that already ended cannot be stopped; that is the goal.",
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailRun"
        }
      ],
      "Next": "FailRun"
    },

    "Succeed": {
      "Type": "Succeed"
    },

    "FailRun": {
      "Type": "Fail",
      "Comment": "The run did not end cleanly. The execution fails with the run's own error so the server's reconciliation and the alarms see it; whether the job itself failed is the server's ledger, not this execution.",
      "Error": "{% $exists($failure.Error) ? $substring($string($failure.Error), 0, 200) : 'RunFailed' %}",
      "Cause": "{% $exists($failure.Cause) ? $substring($string($failure.Cause), 0, 2000) : 'The run ended with an error.' %}"
    },

    "FailUnknownTier": {
      "Type": "Fail",
      "Error": "UnknownTier",
      "Cause": "The job input names a tier other than S, M, L or XL."
    }
  }
}
