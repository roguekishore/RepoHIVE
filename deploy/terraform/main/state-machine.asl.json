{
  "Comment": "repohive-index: one indexing request, from the hosting-2 job input to a recorded outcome (hosting-4 Requirement 11). Every path ends by reading or writing the ledger through the control function, so no execution leaves a job stuck in flight.",
  "QueryLanguage": "JSONata",
  "TimeoutSeconds": 3600,
  "StartAt": "Init",
  "States": {
    "Init": {
      "Type": "Pass",
      "Comment": "job is the input, unchanged; tier is the tier it runs on now and can change when the job asks for a larger one (retier).",
      "Assign": {
        "job": "{% $states.input %}",
        "tier": "{% $states.input.tier %}",
        "retiers": 0,
        "restarted": false,
        "slotAttempts": 0,
        "outcome": "none",
        "inspected": {}
      },
      "Next": "RouteTier"
    },

    "RouteTier": {
      "Type": "Choice",
      "Comment": "S and M run on Lambda, L and XL on Fargate. The job re-runs the pre-check itself, so this does not.",
      "Choices": [
        {
          "Condition": "{% $tier = 'S' or $tier = 'M' %}",
          "Next": "RunLambda"
        }
      ],
      "Default": "AcquireSlot"
    },

    "RunLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${indexer_function_arn}",
        "Payload": "{% $merge([$job, {'tier': $tier}]) %}"
      },
      "TimeoutSeconds": 330,
      "Retry": [
        {
          "ErrorEquals": ["Lambda.TooManyRequestsException"],
          "IntervalSeconds": 5,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Assign": {
        "outcome": "ok"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Assign": { "outcome": "runtime-timeout" },
          "Next": "InspectAfterRun"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "outcome": "runtime-error" },
          "Next": "InspectAfterRun"
        }
      ],
      "Next": "InspectAfterRun"
    },

    "AcquireSlot": {
      "Type": "Task",
      "Comment": "L and XL share one execution slot. The control function takes it, and moves a refused job to waiting-for-slot.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "acquireSlot",
          "jobId": "{% $job.jobId %}",
          "tier": "{% $tier %}"
        }
      },
      "Assign": {
        "acquired": "{% $states.result.Payload.acquired %}",
        "slotAttempts": "{% $slotAttempts + 1 %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "outcome": "runtime-error" },
          "Next": "FailOpenError"
        }
      ],
      "Next": "CheckSlot"
    },

    "CheckSlot": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $acquired = true %}",
          "Next": "ChooseFargateTask"
        },
        {
          "Condition": "{% $slotAttempts >= 20 %}",
          "Next": "FailOpenSlotTimeout"
        }
      ],
      "Default": "WaitForSlot"
    },

    "WaitForSlot": {
      "Type": "Wait",
      "Comment": "Try again every 60 s for at most 20 minutes (20 attempts).",
      "Seconds": 60,
      "Next": "AcquireSlot"
    },

    "ChooseFargateTask": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $tier = 'XL' %}",
          "Next": "RunFargateXL"
        }
      ],
      "Default": "RunFargateL"
    },

    "RunFargateL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${task_definition_family}",
        "LaunchType": "FARGATE",
        "Group": "{% 'job-' & $job.jobId %}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${subnet_a}", "${subnet_b}"],
            "SecurityGroups": ["${security_group}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${container_name}",
              "Environment": [
                { "Name": "REPOHIVE_JOB_INPUT", "Value": "{% $string($merge([$job, {'tier': $tier}])) %}" },
                { "Name": "REPOHIVE_TIME_LIMIT_MS", "Value": "600000" }
              ]
            }
          ]
        }
      },
      "TimeoutSeconds": 780,
      "Retry": [
        {
          "ErrorEquals": ["ECS.AmazonECSException"],
          "IntervalSeconds": 30,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Assign": {
        "outcome": "ok"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Assign": { "outcome": "runtime-timeout" },
          "Next": "ListRunningTasks"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "outcome": "runtime-error" },
          "Next": "ListRunningTasks"
        }
      ],
      "Next": "ReleaseSlot"
    },

    "RunFargateXL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "TaskDefinition": "${task_definition_family}",
        "LaunchType": "FARGATE",
        "Group": "{% 'job-' & $job.jobId %}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${subnet_a}", "${subnet_b}"],
            "SecurityGroups": ["${security_group}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "${container_name}",
              "Environment": [
                { "Name": "REPOHIVE_JOB_INPUT", "Value": "{% $string($merge([$job, {'tier': $tier}])) %}" },
                { "Name": "REPOHIVE_TIME_LIMIT_MS", "Value": "900000" }
              ]
            }
          ]
        }
      },
      "TimeoutSeconds": 1080,
      "Retry": [
        {
          "ErrorEquals": ["ECS.AmazonECSException"],
          "IntervalSeconds": 30,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Assign": {
        "outcome": "ok"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Assign": { "outcome": "runtime-timeout" },
          "Next": "ListRunningTasks"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "outcome": "runtime-error" },
          "Next": "ListRunningTasks"
        }
      ],
      "Next": "ReleaseSlot"
    },

    "ListRunningTasks": {
      "Type": "Task",
      "Comment": "After a timeout or error, list the indexer tasks still running; DescribeRunningTasks keeps this job's.",
      "Resource": "arn:aws:states:::aws-sdk:ecs:listTasks",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "Family": "${task_definition_family}",
        "DesiredStatus": "RUNNING"
      },
      "Assign": {
        "taskArns": "{% $append([], $states.result.TaskArns) %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ReleaseSlot"
        }
      ],
      "Next": "AnyRunningTasks"
    },

    "AnyRunningTasks": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $count($taskArns) > 0 %}",
          "Next": "DescribeRunningTasks"
        }
      ],
      "Default": "ReleaseSlot"
    },

    "DescribeRunningTasks": {
      "Type": "Task",
      "Comment": "The run task states put each task in the group job-<jobId> (ecs:runTask.sync does not accept StartedBy).",
      "Resource": "arn:aws:states:::aws-sdk:ecs:describeTasks",
      "Arguments": {
        "Cluster": "${cluster_arn}",
        "Tasks": "{% $taskArns %}"
      },
      "Assign": {
        "taskArns": "{% $append([], $states.result.Tasks[Group = 'job-' & $job.jobId].TaskArn) %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ReleaseSlot"
        }
      ],
      "Next": "StopRunningTasks"
    },

    "StopRunningTasks": {
      "Type": "Map",
      "Items": "{% $taskArns %}",
      "MaxConcurrency": 1,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "StopTask",
        "States": {
          "StopTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:ecs:stopTask",
            "Arguments": {
              "Cluster": "${cluster_arn}",
              "Task": "{% $states.input %}",
              "Reason": "repohive-index stopped a task left running after a timeout or error"
            },
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "StopTaskIgnored"
              }
            ],
            "End": true
          },
          "StopTaskIgnored": {
            "Type": "Pass",
            "Comment": "A task that already ended cannot be stopped; that is the goal.",
            "End": true
          }
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ReleaseSlot"
        }
      ],
      "Next": "ReleaseSlot"
    },

    "ReleaseSlot": {
      "Type": "Task",
      "Comment": "Every Fargate run, whatever its outcome, gives the slot back (the task also releases its own). A failure here is not fatal: failIfOpen releases it too.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "releaseSlot",
          "jobId": "{% $job.jobId %}"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "InspectAfterRun"
        }
      ],
      "Next": "InspectAfterRun"
    },

    "InspectAfterRun": {
      "Type": "Task",
      "Comment": "The ledger, not the runtime's exit status, says what happened.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "inspect",
          "jobId": "{% $job.jobId %}"
        }
      },
      "Assign": {
        "inspected": "{% $states.result.Payload %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Assign": { "outcome": "runtime-error" },
          "Next": "FailOpenError"
        }
      ],
      "Next": "Decide"
    },

    "Decide": {
      "Type": "Choice",
      "Comment": "In order: a retier goes again on the new tier (twice at most); a job the runtime never started is run once more; a job that did not reach an end state is failed.",
      "Choices": [
        {
          "Condition": "{% $inspected.state = 'queued' and $inspected.tier != $tier and $retiers < 2 %}",
          "Next": "RouteAgain"
        },
        {
          "Condition": "{% $inspected.state = 'queued' and $inspected.tier != $tier %}",
          "Next": "FailOpenRetierLimit"
        },
        {
          "Condition": "{% ($inspected.state = 'queued' or $inspected.state = 'waiting-for-slot') and $inspected.tier = $tier and $restarted = false %}",
          "Next": "RestartRun"
        },
        {
          "Condition": "{% $inspected.state = 'queued' or $inspected.state = 'waiting-for-slot' %}",
          "Next": "FailOpenNotStarted"
        },
        {
          "Condition": "{% $inspected.state = 'succeeded' or $inspected.state = 'failed' %}",
          "Next": "Conclude"
        },
        {
          "Condition": "{% $outcome = 'runtime-timeout' %}",
          "Next": "FailOpenTimeout"
        }
      ],
      "Default": "FailOpenError"
    },

    "RouteAgain": {
      "Type": "Pass",
      "Comment": "The job asked for a larger tier (hosting-2 retier); run it there.",
      "Assign": {
        "tier": "{% $inspected.tier %}",
        "retiers": "{% $retiers + 1 %}",
        "restarted": false,
        "slotAttempts": 0,
        "outcome": "none"
      },
      "Next": "RouteTier"
    },

    "RestartRun": {
      "Type": "Pass",
      "Comment": "The runtime never started the job; try the same tier once more.",
      "Assign": {
        "restarted": true,
        "slotAttempts": 0,
        "outcome": "none"
      },
      "Next": "RouteTier"
    },

    "FailOpenSlotTimeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "failIfOpen",
          "jobId": "{% $job.jobId %}",
          "code": "slot-wait-timeout"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailControl"
        }
      ],
      "Next": "InspectFinal"
    },

    "FailOpenRetierLimit": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "failIfOpen",
          "jobId": "{% $job.jobId %}",
          "code": "retier-limit"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailControl"
        }
      ],
      "Next": "InspectFinal"
    },

    "FailOpenNotStarted": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "failIfOpen",
          "jobId": "{% $job.jobId %}",
          "code": "runtime-not-started"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailControl"
        }
      ],
      "Next": "InspectFinal"
    },

    "FailOpenTimeout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "failIfOpen",
          "jobId": "{% $job.jobId %}",
          "code": "runtime-timeout"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailControl"
        }
      ],
      "Next": "InspectFinal"
    },

    "FailOpenError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "failIfOpen",
          "jobId": "{% $job.jobId %}",
          "code": "runtime-error"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailControl"
        }
      ],
      "Next": "InspectFinal"
    },

    "InspectFinal": {
      "Type": "Task",
      "Comment": "Read the ledger again after failIfOpen: a job that ended on its own in the meantime keeps its own class and code.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "${control_function_arn}",
        "Payload": {
          "op": "inspect",
          "jobId": "{% $job.jobId %}"
        }
      },
      "Assign": {
        "inspected": "{% $states.result.Payload %}"
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FailControl"
        }
      ],
      "Next": "Conclude"
    },

    "Conclude": {
      "Type": "Choice",
      "Comment": "Succeed when the job succeeded or failed through the user's doing; fail the execution, named after the code, when the failure was ours.",
      "Choices": [
        {
          "Condition": "{% $inspected.state = 'succeeded' %}",
          "Next": "Succeed"
        },
        {
          "Condition": "{% $inspected.state = 'failed' and $inspected.failureClass = 'user' %}",
          "Next": "Succeed"
        },
        {
          "Condition": "{% $inspected.state = 'failed' %}",
          "Next": "FailSystem"
        }
      ],
      "Default": "FailUnexpected"
    },

    "Succeed": {
      "Type": "Succeed"
    },

    "FailSystem": {
      "Type": "Fail",
      "Error": "{% $string($inspected.failureCode) %}",
      "Cause": "{% 'The job failed with a system failure: ' & $string($inspected.failureCode) %}"
    },

    "FailUnexpected": {
      "Type": "Fail",
      "Error": "UnexpectedLedgerState",
      "Cause": "The job is not in an end state after failIfOpen."
    },

    "FailControl": {
      "Type": "Fail",
      "Error": "ControlFunctionFailed",
      "Cause": "The control function could not be reached; the EventBridge rule calls failIfOpen when this execution ends."
    }
  }
}
