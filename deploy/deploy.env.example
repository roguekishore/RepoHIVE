# Copy to deploy/deploy.env (git-ignored) and fill in. Every script reads this file and nothing else for
# these values. The AWS profile is not set here: export AWS_PROFILE before running a script.
# Plain KEY=VALUE lines only; they are parsed, not sourced, so no quoting or expansion is needed.

# The 12-digit id of the fresh ap-south-1 account. Every script stops if `aws sts get-caller-identity`
# reports a different account.
AWS_ACCOUNT_ID=123456789012

# Always ap-south-1; every aws call passes it with --region.
AWS_REGION=ap-south-1

# The public name users visit (repohive.dev or a name under it); the origin domain is origin.<this>.
SITE_DOMAIN=repohive.dev

# The three buckets, as the bootstrap and main roots name them (<prefix>-<account id>).
ARTIFACT_BUCKET=repohive-artifacts-123456789012
OPS_BUCKET=repohive-ops-123456789012
STATE_BUCKET=repohive-tfstate-123456789012
