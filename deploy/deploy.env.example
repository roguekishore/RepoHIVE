# Copy to deploy/accounts/<name>/deploy.env (git-ignored), one folder per AWS account, and fill it in. Every script
# reads the account named by REPOHIVE_ACCOUNT=<name> from there, and nothing else for these values.
# <name>: lower-case letters and digits, starting with a letter, at most 20 characters (for example test, prod).
# Plain KEY=VALUE lines only; they are parsed, not sourced, so no quoting or expansion is needed.
#
# Credentials are not here. The scripts use the AWS CLI profile `repohive` (~/.aws/credentials) unless AWS_PROFILE
# names another, and stop if `aws sts get-caller-identity` reports an account other than AWS_ACCOUNT_ID below.

# The 12-digit id of the account. The bucket names are derived from it: repohive-artifacts-<id>, repohive-ops-<id>,
# repohive-tfstate-<id>.
AWS_ACCOUNT_ID=123456789012

# The public name users visit: repohive.dev or a name under it; the origin domain is origin.<this>. A name can be
# served by only one CloudFront distribution in the world, so two accounts that run at the same time need two names
# (for example test.repohive.dev for a test account, app.repohive.dev for production).
SITE_DOMAIN=test.repohive.dev

# The Owner tag on every resource, and the address that gets the alarm and budget emails.
OWNER_TAG=owner@example.com
ALERT_EMAIL=owner@example.com

# true for production (deletion and termination protection on). false only for a test account you will remove with
# deploy/scripts/teardown.sh, which refuses an account where this is true.
PROTECT=false

# Only if the account already has a GitHub OIDC provider (IAM > Identity providers > token.actions.githubusercontent.com):
# an account can hold one per URL, so the bootstrap reuses it instead of creating a second.
# GITHUB_OIDC_PROVIDER_ARN=arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com

# Always ap-south-1 (the default); every aws call passes it with --region.
# AWS_REGION=ap-south-1
