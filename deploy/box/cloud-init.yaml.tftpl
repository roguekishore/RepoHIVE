#cloud-config
# First boot of the app box. Rendered by templatefile in box.tf. Everything here is
# non-secret: secrets are read from SSM by repohive-env on the box and never reach user data (13.8). The
# gz+b64 blobs are the repository's own files, so the units and scripts are written once.
write_files:
  - path: /etc/repohive/box.env
    permissions: "0644"
    content: |
      AWS_REGION=${region}
      SITE_DOMAIN=${site_domain}
      ORIGIN_DOMAIN=${origin_domain}
      ARTIFACT_BUCKET=${artifact_bucket}
      OPS_BUCKET=${ops_bucket}
      STATE_MACHINE_ARN=${state_machine_arn}
      DATA_VOLUME_ID=${data_volume_id}
      RATE_LIMIT_PER_MINUTE=${rate_limit_per_minute}
      RATE_LIMIT_API_POST_PER_MINUTE=${rate_limit_api_post_per_minute}
      SERVER_HEAP_MB=${server_heap_mb}
      ADMIN_ORIGINS=${admin_origins}
  - path: /etc/systemd/system/repohive-server.service.d/10-limits.conf
    permissions: "0644"
    content: |
      [Service]
      MemoryMax=${server_memory_max_mb}M
  - path: /usr/local/sbin/repohive-env
    permissions: "0755"
    encoding: gz+b64
    content: ${script_env}
  - path: /usr/local/sbin/repohive-first-boot
    permissions: "0755"
    encoding: gz+b64
    content: ${script_first_boot}
  - path: /usr/local/sbin/repohive-activate
    permissions: "0755"
    encoding: gz+b64
    content: ${script_activate}
  - path: /usr/local/sbin/repohive-heartbeat
    permissions: "0755"
    encoding: gz+b64
    content: ${script_heartbeat}
  - path: /etc/repohive/boot/logrotate-repohive
    permissions: "0644"
    encoding: gz+b64
    content: ${logrotate}
  - path: /etc/repohive/boot/amazon-cloudwatch-agent.json
    permissions: "0644"
    encoding: gz+b64
    content: ${agent_config}
%{ for name, content in units ~}
  - path: /etc/repohive/boot/systemd/${name}
    permissions: "0644"
    encoding: gz+b64
    content: ${content}
%{ endfor ~}

runcmd:
  - [/usr/local/sbin/repohive-first-boot]
