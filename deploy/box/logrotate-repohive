# Daily rotation of the web and worker logs (hosting-4 Requirement 16.2). systemd keeps the files open
# (StandardOutput=append:), so each is copied and truncated rather than moved. The CloudWatch agent follows
# the file across the truncation. Caddy rotates its own access log.
/var/log/repohive/web.log /var/log/repohive/worker.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
