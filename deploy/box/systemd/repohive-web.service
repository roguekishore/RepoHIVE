[Unit]
Description=RepoHIVE: Next.js server
Requires=repohive-env.service
After=repohive-env.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/repohive

[Service]
Type=simple
User=repohive
Group=repohive
EnvironmentFile=/run/repohive/web.env
# The standalone server of a monorepo build: packages/web/server.js under the release's app/ tree.
WorkingDirectory=/opt/repohive/current/app/packages/web
ExecStart=/opt/repohive/current/bin/node server.js
# Output goes to a file the CloudWatch agent ships. logrotate copies and truncates it.
StandardOutput=append:/var/log/repohive/web.log
StandardError=append:/var/log/repohive/web.log
# Default limits; /etc/systemd/system/repohive-web.service.d/10-limits.conf, written by cloud-init from
# Terraform variables, overrides MemoryMax and NODE_OPTIONS (unmeasured defaults).
MemoryMax=768M
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
