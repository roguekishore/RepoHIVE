[Unit]
Description=RepoHIVE: Spring Boot server (API, accounts, quota, job ledger, pre-check)
Requires=repohive-env.service
After=repohive-env.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/repohive

[Service]
Type=simple
User=repohive
Group=repohive
EnvironmentFile=/run/repohive/server.env
# The release's own Java runtime and jar. The data directory (SQLite) is REPOHIVE_DATA_DIR on the data volume; the
# working directory holds no config/ folder, so the optional local settings import finds nothing.
WorkingDirectory=/var/lib/repohive/data
ExecStart=/opt/repohive/current/java/bin/java -jar /opt/repohive/current/server/repohive-server.jar
# The JVM exits with 143 when systemd stops it; that is a clean stop.
SuccessExitStatus=143
# Spring Boot, Flyway and the first SQLite open on a t4g.small.
TimeoutStartSec=180
TimeoutStopSec=30
# Output goes to a file the CloudWatch agent ships. logrotate copies and truncates it.
StandardOutput=append:/var/log/repohive/server.log
StandardError=append:/var/log/repohive/server.log
# Default limit; /etc/systemd/system/repohive-server.service.d/10-limits.conf, written by cloud-init from the
# Terraform variable, overrides MemoryMax (unmeasured default). The pre-check's Node child counts against it.
MemoryMax=1280M
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
