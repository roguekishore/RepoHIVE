[Unit]
Description=RepoHIVE: background worker
Requires=repohive-env.service
After=repohive-env.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/repohive

[Service]
Type=simple
User=repohive
Group=repohive
EnvironmentFile=/run/repohive/worker.env
# Same start as `npm run worker` in packages/web, without the local env files: the alias loader maps @/ to
# src/, and Node strips the types from the .ts files it imports.
WorkingDirectory=/opt/repohive/current/app/packages/web
ExecStart=/opt/repohive/current/bin/node --import ./scripts/register-aliases.mjs scripts/run-worker.mjs
StandardOutput=append:/var/log/repohive/worker.log
StandardError=append:/var/log/repohive/worker.log
# Default limit; the drop-in 10-limits.conf overrides it from Terraform (unmeasured default).
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
