[Unit]
Description=RepoHIVE: Caddy (TLS and reverse proxy for CloudFront)
Requires=repohive-env.service
After=repohive-env.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/repohive

[Service]
Type=simple
User=caddy
Group=caddy
EnvironmentFile=/run/repohive/caddy.env
# Certificates and ACME state live on the data volume so a replaced box keeps them.
Environment=XDG_DATA_HOME=/var/lib/repohive/caddy XDG_CONFIG_HOME=/var/lib/repohive/caddy-config
ExecStart=/opt/repohive/current/bin/caddy run --config /opt/repohive/current/box/Caddyfile --adapter caddyfile
ExecReload=/opt/repohive/current/bin/caddy reload --config /opt/repohive/current/box/Caddyfile --adapter caddyfile --force
# Requirement 13.6: only the capability needed to bind ports 80 and 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
LimitNOFILE=1048576
MemoryMax=256M
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
