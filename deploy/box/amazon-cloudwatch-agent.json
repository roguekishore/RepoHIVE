{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/repohive/web.log",
            "log_group_name": "/repohive/box/web",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/repohive/worker.log",
            "log_group_name": "/repohive/box/worker",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/repohive/caddy-access.log",
            "log_group_name": "/repohive/box/caddy",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/repohive/heartbeat.log",
            "log_group_name": "/repohive/box/heartbeat",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          }
        ]
      }
    }
  }
}
