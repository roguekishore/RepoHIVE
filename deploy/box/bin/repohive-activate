#!/usr/bin/env bash
# The release activation script (hosting-4 Requirement 15.3), run on the box through SSM Run Command:
#
#   repohive-activate <version> <sha256>       activate a release from s3://<ops bucket>/releases/
#   repohive-activate --rollback               switch back to the previous release
#
# Verify the checksum, unpack to /opt/repohive/releases/<version>, switch /opt/repohive/current, reload Caddy,
# restart the web and worker units, then poll /healthz for 60 s. If it never answers ok, switch back to the
# previous release, restart, and exit non-zero. Keeps the 3 newest releases. Never touches /var/lib/repohive.
set -euo pipefail

RELEASES=/opt/repohive/releases
CURRENT=/opt/repohive/current
BOX_ENV=/etc/repohive/box.env
KEEP=3

die() {
  printf 'activate: %s\n' "$*" >&2
  exit 1
}

box_value() {
  sed -n "s/^$1=//p" "${BOX_ENV}"
}

# Empty when there is no current release yet: readlink -f would print the path of a missing link, and switching
# back to it would point current at itself.
previous_target() {
  readlink -e "${CURRENT}" 2>/dev/null || true
}

# Installs what ships in a release: units, the agent configuration, the scripts, the logrotate rule.
install_from_release() {
  local dir="$1"
  install -m 0644 "${dir}"/box/systemd/*.service /etc/systemd/system/
  install -m 0644 "${dir}"/box/systemd/*.timer /etc/systemd/system/
  install -m 0644 "${dir}/box/logrotate-repohive" /etc/logrotate.d/repohive
  install -m 0755 "${dir}/box/bin/repohive-env" /usr/local/sbin/repohive-env
  install -m 0755 "${dir}/box/bin/repohive-first-boot" /usr/local/sbin/repohive-first-boot
  install -m 0755 "${dir}/box/bin/repohive-activate" /usr/local/sbin/repohive-activate.new
  mv -f /usr/local/sbin/repohive-activate.new /usr/local/sbin/repohive-activate
  if [[ -f "${dir}/box/bin/repohive-heartbeat" ]]; then
    install -m 0755 "${dir}/box/bin/repohive-heartbeat" /usr/local/sbin/repohive-heartbeat
  fi
  install -m 0644 "${dir}/box/amazon-cloudwatch-agent.json" /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
  systemctl daemon-reload
  systemctl enable --now repohive-heartbeat.timer
  /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json >/dev/null
}

# Env files first (the secrets may have rotated), then Caddy and the two app units.
restart_units() {
  systemctl restart repohive-env.service
  if systemctl is-active --quiet caddy.service; then
    systemctl reload caddy.service
  else
    systemctl restart caddy.service
  fi
  systemctl restart repohive-web.service repohive-worker.service
}

healthy() {
  local body
  for _ in $(seq 1 30); do
    body="$(curl -fsS --max-time 2 http://127.0.0.1:3000/healthz 2>/dev/null || true)"
    if [[ "${body}" == *'"status":"ok"'* || "${body}" == *'"status": "ok"'* ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

switch_to() {
  local target="$1"
  ln -sfn "${target}" "${CURRENT}.new"
  mv -T -f "${CURRENT}.new" "${CURRENT}"
}

prune() {
  local count=0 dir
  # Newest first; the active release is never removed.
  while IFS= read -r dir; do
    count=$((count + 1))
    if ((count > KEEP)) && [[ "${dir}" != "$(previous_target)" ]]; then
      rm -rf -- "${dir}"
    fi
  done < <(find "${RELEASES}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
}

if [[ "${1:-}" == "--rollback" ]]; then
  active="$(previous_target)"
  target=""
  while IFS= read -r dir; do
    [[ "${dir}" == "${active}" ]] && continue
    target="${dir}"
    break
  done < <(find "${RELEASES}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
  [[ -n "${target}" ]] || die "no earlier release to roll back to"
  printf 'activate: rolling back %s -> %s\n' "${active:-none}" "${target}"
  switch_to "${target}"
  install_from_release "${target}"
  restart_units
  healthy || die "the previous release did not report ok either"
  printf 'activate: rolled back to %s\n' "${target}"
  exit 0
fi

version="${1:-}"
checksum="${2:-}"
[[ "${version}" =~ ^[A-Za-z0-9._-]+$ ]] || die "usage: repohive-activate <version> <sha256> | --rollback"
[[ "${checksum}" =~ ^[0-9a-f]{64}$ ]] || die "the checksum must be 64 lower-case hex digits"

ops_bucket="$(box_value OPS_BUCKET)"
region="$(box_value AWS_REGION)"
[[ -n "${ops_bucket}" && -n "${region}" ]] || die "OPS_BUCKET or AWS_REGION missing from ${BOX_ENV}"

work="$(mktemp -d /var/tmp/repohive-release.XXXXXX)"
trap 'rm -rf -- "${work}"' EXIT
bundle="${work}/repohive-${version}.tar.gz"
aws --region "${region}" s3 cp --only-show-errors "s3://${ops_bucket}/releases/repohive-${version}.tar.gz" "${bundle}"

actual="$(sha256sum "${bundle}" | cut -d' ' -f1)"
[[ "${actual}" == "${checksum}" ]] || die "checksum mismatch: expected ${checksum}, got ${actual}"

previous="$(previous_target)"
target="${RELEASES}/${version}"
rm -rf -- "${target}.partial"
mkdir -p "${target}.partial"
tar -xzf "${bundle}" -C "${target}.partial"
rm -rf -- "${target}"
mv -T "${target}.partial" "${target}"
# The units run as repohive and caddy, so the release root must be enterable whatever mode the archive carried; and
# the archive's fixed mtime would tie every release, so the unpack time orders them for prune and --rollback.
chmod 0755 "${target}"
touch "${target}"
printf 'activate: unpacked %s\n' "${target}"

switch_to "${target}"
install_from_release "${target}"
# A unit that fails to start must reach the health check and the switch back below, not stop the script here.
restart_units || printf 'activate: a unit failed to restart\n' >&2

if healthy; then
  prune
  printf 'activate: %s is live\n' "${version}"
  exit 0
fi

printf 'activate: %s did not report ok within 60 s\n' "${version}" >&2
if [[ -n "${previous}" && -d "${previous}" ]]; then
  switch_to "${previous}"
  install_from_release "${previous}"
  restart_units || true
  printf 'activate: switched back to %s\n' "${previous}" >&2
else
  printf 'activate: there is no previous release to switch back to\n' >&2
fi
exit 1
