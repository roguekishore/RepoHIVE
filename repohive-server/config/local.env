# Local development only. Loaded through spring.config.import in application.yml.
# No real secrets belong here. Relative paths resolve against repohive-server/.
REPOHIVE_MODE=local
REPOHIVE_SITE_ORIGIN=http://localhost:3000
REPOHIVE_DATA_DIR=../.repohive-local/data
REPOHIVE_STORE=local:../.repohive-local
REPOHIVE_ORCHESTRATOR=local
REPOHIVE_INTERNAL_SECRET=local-dev-internal-secret
REPOHIVE_INDEXER_DIR=../packages/indexer
