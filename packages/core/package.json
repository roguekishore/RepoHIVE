{
  "name": "@repohive/core",
  "version": "0.0.0",
  "private": true,
  "description": "RepoHIVE grouping algorithm — graph.json → adaptive multi-level hierarchy → index/*.json.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/",
    "group": "node ./dist/group-cli.js",
    "demo:group-determinism": "node ./dist/demo-group-determinism.js",
    "demo:baselines": "node ./dist/demo-baselines.js"
  },
  "dependencies": {
    "@repohive/shared": "0.0.0",
    "graphology": "0.26.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-metrics": "2.4.0"
  },
  "devDependencies": {
    "fast-check": "4.8.0"
  },
  "license": "AGPL-3.0-or-later"
}
