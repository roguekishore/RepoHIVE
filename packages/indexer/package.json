{
  "name": "@repohive/indexer",
  "version": "0.0.0",
  "private": true,
  "description": "RepoHIVE hosted indexing job: a GitHub repository in, an immutable published snapshot out.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "job": "node dist/cli.js",
    "test": "node ../../scripts/run-node-tests.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-ssm": "3.1144.0",
    "@repohive/core": "0.0.0",
    "@repohive/engine": "0.0.0",
    "@repohive/views": "0.0.0",
    "tar-stream": "3.2.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "aws-sdk-client-mock": "4.1.0"
  },
  "license": "AGPL-3.0-or-later"
}
