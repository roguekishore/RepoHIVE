# Local-mode settings for the app (hosting-3 Requirement 1). No secrets.
# Paths are relative to packages/web, where the app, the seed command and the worker run.
#
# Next.js reads .env.local, not this file. To run the app locally:
#   Copy-Item packages/web/config/local.env packages/web/.env.local
# The seed command (npm run seed --workspace @repohive/web) reads this file, then .env.local if present.
REPOHIVE_MODE=local
REPOHIVE_SITE_ORIGIN=http://localhost:3000
REPOHIVE_DATA_DIR=../../.repohive-local/data
REPOHIVE_STORE=local:../../.repohive-local/store
REPOHIVE_LEDGER=file:../../.repohive-local/ledger.json
REPOHIVE_ORCHESTRATOR=local
