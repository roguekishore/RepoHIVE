{
  "name": "@repohive/web",
  "version": "0.3.0",
  "private": true,
  "description": "RepoHIVE web app: the Next.js viewer, its account and index-request routes, and the background worker",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "seed": "node --env-file-if-exists=config/local.env --env-file-if-exists=.env.local scripts/seed-local.mjs",
    "worker": "node --env-file-if-exists=config/local.env --env-file-if-exists=.env.local --import ./scripts/register-aliases.mjs scripts/run-worker.mjs",
    "start-local": "node scripts/start-local.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-sfn": "3.1144.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@repohive/core": "*",
    "@repohive/design": "*",
    "@repohive/indexer": "*",
    "@repohive/views": "*",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.7.0",
    "next": "~15.5.21",
    "next-themes": "^0.4.6",
    "nuqs": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.3",
    "swr": "^2.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@repohive/engine": "*",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
