{
  "name": "@repohive/web",
  "version": "0.3.0",
  "private": true,
  "description": "RepoHIVE web app: the Next.js viewer, its account and index-request routes, and the background worker",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "seed": "node --env-file-if-exists=config/local.env --env-file-if-exists=.env.local scripts/seed-local.mjs",
    "worker": "node --env-file-if-exists=config/local.env --env-file-if-exists=.env.local --import ./scripts/register-aliases.mjs scripts/run-worker.mjs",
    "start-local": "node scripts/start-local.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-sfn": "3.1144.0",
    "@repohive/core": "*",
    "@repohive/design": "*",
    "@repohive/indexer": "*",
    "@repohive/views": "*",
    "geist": "^1.3.0",
    "next": "~15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@repohive/engine": "*",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.7",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
