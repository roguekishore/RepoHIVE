{
  "name": "@repohive/web",
  "version": "0.3.0",
  "private": true,
  "description": "RepoHIVE Web UI — Next.js 15 dashboard and wiki viewer",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "seed": "node --env-file-if-exists=config/local.env --env-file-if-exists=.env.local scripts/seed-local.mjs",
    "worker": "node --env-file-if-exists=config/local.env --env-file-if-exists=.env.local --import ./scripts/register-aliases.mjs scripts/run-worker.mjs",
    "start-local": "node scripts/start-local.mjs",
    "e2e": "node scripts/hosting-3-e2e.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1144.0",
    "@aws-sdk/client-s3": "3.1144.0",
    "@aws-sdk/client-sfn": "3.1144.0",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@repohive/api-client": "*",
    "@repohive/core": "*",
    "@repohive/indexer": "*",
    "@repohive/types": "*",
    "@repohive/ui": "*",
    "@repohive/views": "*",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "framer-motion": "^11.11.0",
    "geist": "^1.3.0",
    "lucide-react": "^0.460.0",
    "next": "~15.5.21",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.22.0",
    "sonner": "^2.0.7",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@repohive/engine": "*",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/d3": "^7.4.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.2.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
