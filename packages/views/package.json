{
  "name": "@repohive/views",
  "version": "0.0.0",
  "private": true,
  "description": "RepoHIVE view builders: the viewer's response bodies, built from a grouping output.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./views-version": {
      "types": "./dist/views-version-const.d.ts",
      "default": "./dist/views-version-const.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/write-views-version.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repohive/core": "0.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
