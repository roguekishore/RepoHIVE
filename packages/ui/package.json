{
  "name": "@repohive/ui",
  "version": "0.1.0",
  "description": "Shared visualization components for the RepoHIVE dashboard (packages/web) and downstream consumers. Domains: graph, git, dead-code, decisions, docs, symbols, coverage, wiki, chat, dashboard, workspace, jobs, blast-radius, plus shared primitives and hooks.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "styles",
    "scripts"
  ],
  "sideEffects": [
    "./styles/globals.css",
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles/globals.css",
    "./graph/context": "./src/graph/context.ts",
    "./graph/elk-layout": "./src/graph/elk-layout.ts",
    "./graph/use-module-filter": "./src/graph/use-module-filter.ts",
    "./graph/*": "./src/graph/*.tsx",
    "./health": "./src/health/index.ts",
    "./health/*": "./src/health/*.tsx",
    "./docs/*": "./src/docs/*.tsx",
    "./wiki/*": "./src/wiki/*.tsx",
    "./stats": "./src/stats/index.ts",
    "./overview": "./src/overview/index.ts",
    "./overview/*": "./src/overview/*.tsx",
    "./onboarding/*": "./src/onboarding/*.tsx",
    "./zoom": "./src/zoom/index.ts",
    "./zoom/*": "./src/zoom/*.tsx",
    "./repohive": "./src/repohive/index.ts",
    "./repohive/*": "./src/repohive/*.tsx",
    "./settings": "./src/settings/index.ts",
    "./settings/*": "./src/settings/*.tsx",
    "./shared": "./src/shared/index.ts",
    "./shared/entity": "./src/shared/entity/index.ts",
    "./shared/responsive-table": "./src/shared/responsive-table/index.ts",
    "./shared/context-drawer": "./src/shared/context-drawer/index.ts",
    "./shared/*": "./src/shared/*.tsx",
    "./ui/*": "./src/ui/*.tsx",
    "./lib/cn": "./src/lib/cn.ts",
    "./lib/command-palette-scope": "./src/lib/command-palette-scope.ts",
    "./lib/confidence": "./src/lib/confidence.ts",
    "./lib/errors": "./src/lib/errors.ts",
    "./lib/format": "./src/lib/format.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "gates": "bash ./scripts/ui-gates.sh"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@repohive/types": "*",
    "@sigma/edge-curve": "^3.1.0",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "elkjs": "^0.11.1",
    "fuse.js": "^7.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.15.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  },
  "bin": {
    "repowise-ui-gates": "./scripts/ui-gates.sh",
    "repowise-ui-no-raw-hex": "./scripts/no-raw-hex-check.sh",
    "repowise-ui-contrast-check": "./scripts/contrast-check.py"
  }
}
